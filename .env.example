# Backend API base URL (Laravel). Copy this file to .env and edit.
# Local:      http://localhost:8000/api
# Production: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:8000/api

# Public website address — used for the share (WhatsApp/Facebook) picture and llms.txt. Example: https://damvolt.com
VITE_SITE_URL=
